      <div class="story-copy">
        <p class="kicker">{% if item.inSeason %}In season, {{ item.season }}{% else %}Between seasons, returns {{ item.season }}{% endif %}{% if stories.length %} · {{ stories.length }} {{ "story" if stories.length == 1 else "stories" }}{% endif %}</p>
        <h2 class="story-title"><a href="{{ item.path | url }}">{{ item.name }}</a></h2>
        <p class="deck">{{ item.description }}</p>
      </div>
    </article>
  </li>
{% endfor %}
</ul>
