{% if stories and stories.length %}
<ul class="story-list">
  {% for post in stories %}
  <li{% if post.data.hero and post.data.hero.src %} class="has-thumb"{% endif %}>
    {% if post.data.hero and post.data.hero.src %}
    <a class="story-thumb-link" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
      <img class="story-thumb" src="{{ ('/assets/images/' ~ post.data.hero.src ~ '.webp') | url }}" alt="" width="160" height="90" loading="lazy">
    </a>
    {% endif %}
    <article>
      <p class="story-kicker">
        {% if post.data.draft %}<span class="badge">Unpublished draft</span>{% endif %}
        <a href="{{ (post.data.category | categoryPath) | url }}">{{ post.data.category }}</a>
        <time datetime="{{ post.date | isoDate }}">{{ post.date | displayDate }}</time>
      </p>
      {% if storyHeading == "h3" %}
      <h3 class="story-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      {% else %}
      <h2 class="story-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      {% endif %}
      <p>{{ post.data.summary }}</p>
    </article>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="empty">{{ emptyNote or "No story has been published yet." }}</p>
{% endif %}
