  <div class="history-table-wrap">
    <table class="history-table" id="history-table">
      <caption class="visually-hidden">Confirmed NHL starting goalies with a league or club source, {{ goalieHistory.coverageStart | displayDate }} to {{ goalieHistory.coverageEnd | displayDate }}</caption>
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Game (ET)</th>
          <th scope="col">Side</th>
          <th scope="col">Team</th>
          <th scope="col">Goalie</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {% for row in goalieHistory.rows %}
        <tr>
          <td><a href="{{ ('/nhl/starting-goalies/' ~ row.date ~ '/') | url }}">{{ row.date }}</a></td>
          <td>{{ row.matchup }} <span class="game-time">{{ row.time }}</span></td>
          <td>{{ "Away" if row.side == "away" else "Home" }}</td>
          <td>{{ row.team }}</td>
          <td>{{ row.goalie }}</td>
          <td><a href="{{ row.sourceUrl }}">{{ row.sourceName }}</a></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p id="history-empty" class="history-empty" hidden>No row matches that filter. Clear the box to see the full file.</p>

