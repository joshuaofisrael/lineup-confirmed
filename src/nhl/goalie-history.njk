<article class="page history-page">
  <header class="page-head">
    <h1>{{ title }}</h1>
    <p class="dek">{{ summary }}</p>
    <p class="last-updated">Last updated <time datetime="2026-11-21">November 21, 2026</time>. The file is rebuilt from the nightly board.</p>
