<script>
(function () {
  var input = document.getElementById("history-filter");
  var rows = document.querySelectorAll("#history-table tbody tr");
  var empty = document.getElementById("history-empty");
  if (!input || !rows.length) return;
  function apply() {
    var query = input.value.trim().toLowerCase();
    var shown = 0;
    for (var i = 0; i < rows.length; i++) {
      var ok = !query || rows[i].textContent.toLowerCase().indexOf(query) !== -1;
      rows[i].hidden = !ok;
      if (ok) shown += 1;
    }
    if (empty) empty.hidden = shown !== 0;
  }
  input.addEventListener("input", apply);
  var preset = new URLSearchParams(window.location.search).get("q") || new URLSearchParams(window.location.search).get("date") || "";
  if (preset) {
    input.value = preset;
    apply();
  }
})();
</script>
